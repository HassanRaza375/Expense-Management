# Names of the environment variables Hisaab reads. This file holds NO values: copy it to `.env` (gitignored) and fill it in yourself.
# docs/DEPLOY.md has the full table (which are secrets, where each one goes, in what order).

# --- the app flag (public, not a secret). Off in a build until you turn it on. Only 1 or true means on.
NUXT_PUBLIC_SYNC_ENABLED=

# --- PostgreSQL (Aiven). Use a TEST database for local work, never production.
DATABASE_URL=
# Aiven's project CA: either the PEM text itself, or a path to the .pem file. Certificate checks are never turned off.
DATABASE_CA_CERT=
DATABASE_CA_FILE=

# --- accounts (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# off until their keys exist:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# --- Cloudinary (profile photo and receipts only). CLOUDINARY_URL alone is enough; the three below are an alternative.
# CLOUDINARY_FOLDER is the root folder every file lives under (default "hisaab"; the live checks use "hisaab-test").
CLOUDINARY_FOLDER=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- read ONLY by scripts/seed-super-admin.mjs, never by the app
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
